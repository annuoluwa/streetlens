# Server
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000

# Database (use DATABASE_URL for production, or individual vars for local dev)
DATABASE_URL=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=streetlens

# Authentication
JWT_SECRET=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Mailtrap for dev, real SMTP for production)
MAILTRAP_USER=
MAILTRAP_PASS=

# Contact form — address that receives messages from the contact page
CONTACT_EMAIL=

# Admin notifications — address that receives flagged-report alerts
ADMIN_NOTIFY_TO=
